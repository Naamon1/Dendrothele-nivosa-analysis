```{r}
#pearson statistical info
# Set your target organism
target <- "Dendrothele nivosa"

# Get all organisms except the target
others <- setdiff(rownames(cazyme_data_matrix), target)

# Initialize results data frame
nivosa_cor_results <- data.frame(
  Organism = character(),
  Correlation = numeric(),
  P_value = numeric(),
  stringsAsFactors = FALSE
)

# Loop over each other organism
for (org in others) {
  test_result <- cor.test(cazyme_data_matrix[target, ], cazyme_data_matrix[org, ], method = "pearson")
  
  nivosa_cor_results <- rbind(nivosa_cor_results, data.frame(
    Organism = org,
    Correlation = test_result$estimate,
    P_value = test_result$p.value
  ))
}

# Sort by correlation strength (optional)
nivosa_cor_results <- nivosa_cor_results[order(-nivosa_cor_results$Correlation), ]

# View results
print(nivosa_cor_results)

