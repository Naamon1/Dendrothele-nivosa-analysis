```{r}
#comparing CAZyme profiles statistically 2026 attempt
#First I made a data matrix of the organisms, CAZy types, and counts. Then I made a metadata table with the organisms, groups, and ecological niche

#load necessary libraries
library(dplyr)
library(vegan)

#1. Load or prepare your data
cazyme_data_matrix <- read.csv("C:/Users/naamo/OneDrive/Documents/DnivRevisions/transposed_data_matrix.csv")

meta_cazyme_data <- read.csv("C:/Users/naamo/OneDrive/Documents/DnivRevisions/meta_data_matrix.csv")

#Make sure 'Organism' is the row name
rownames(cazyme_data_matrix) <- cazyme_data_matrix$Organism
cazyme_data_matrix <- cazyme_data_matrix[ , -1]  # remove the Organism column

# 2. Normalize to relative abundance (row-wise)
cazyme_rel_abund <- cazyme_data_matrix / rowSums(cazyme_data_matrix)

# 3. Compute Bray-Curtis distance matrix
cazy_bray_dist <- vegdist(cazyme_rel_abund, method = "bray")

# 4. Join metadata
# Make sure rownames in metadata match the order of rows in cazyme_rel_abund
meta_cazyme_data <- meta_cazyme_data[match(rownames(cazyme_rel_abund), meta_cazyme_data$Organism), ]

# 5. Run PERMANOVA (e.g., testing for Group differences)
cazy_permanova_result <- adonis2(cazy_bray_dist ~ Group, data = meta_cazyme_data)

# 6. View results
print(cazy_permanova_result)

```
```{r}
#creating a PCoA plot from the PERMANOVA data
library(ggplot2)

#compute PCoA (Classical MDS values)
pcoa_result <- cmdscale(cazy_bray_dist, k = 2, eig = TRUE)  # k = number of dimensions

#Create PCoA dataframe
# Pull out coordinates
pcoapoints <- as.data.frame(pcoa_result$points)
colnames(pcoapoints) <- c("PCoA1", "PCoA2")

# Add sample and metadata info
pcoapoints$Organism <- rownames(pcoapoints)
pcoapoints <- merge(pcoapoints, meta_cazyme_data, by = "Organism")

#Calculate variance explained (optional, for axis labels)
eig_vals <- pcoa_result$eig
var_explained <- round(100 * eig_vals[1:2] / sum(eig_vals), 1)

#label groups
pcoapoints$Group <- factor(
  pcoapoints$Group,
  levels = c("A","B","C","D","E"),  # <-- use your current Group values
  labels = c("Dendrothele Nivosa","Wood Decay","Plant Pathogen","ECM","Soil Saprotroph")
)

#Plot with ggplot2
dnivpcoa <- ggplot(pcoapoints, aes(x = PCoA1, y = PCoA2, color = Group, label = Organism)) +
  geom_point(size = 4, alpha = 0.8) + 
  geom_text(vjust = -0.5, size = 2.5) +  # Use geom_label()
  coord_cartesian(xlim = c(-0.0, 0.16), ylim = c(-0.1, 0.1)) + theme_minimal() +
  labs(
    title = "PCoA (Bray-Curtis)",
    x = paste0("PCoA1 (", var_explained[1], "%)"),
    y = paste0("PCoA2 (", var_explained[2], "%)")
  ) +
  theme(
    text = element_text(size = 14),
    legend.title = element_text(size = 13),
    legend.text = element_text(size = 12)
  )

#show result 
print(dnivpcoa)

#save

ggsave("C:/Users/naamo/OneDrive/Documents/DnivRevisions/dnivpcoa.png", plot = dnivpcoa,
       width = 8, height = 6, dpi = 300)

#save as pdf
ggsave("C:/Users/naamo/OneDrive/Documents/DnivRevisions/dnivpcoa.pdf", plot = dnivpcoa, width = 8, height = 6)

```


