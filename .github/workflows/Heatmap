```{r}
#normalizing CAZYme data 
library(dplyr)

#step 1:import matrix. row.names=1 means the first column will be recognized as labels

X <- read.csv("C:/Users/naamo/OneDrive/Documents/DnivRevisions/transposed_data_matrix.csv", row.names = 1, check.names = FALSE)

#step 2: convert the dataframe into a matrix

X_mat <- as.matrix(X)

#step 3: normalize across columns since the transposed data matrix has the CAZYme categories as columns

X_colprop <- sweep(X_mat, 2, colSums(X_mat, na.rm = TRUE), "/")

#look at outputs

print(X_colprop)          # or just X_colprop

#save outputs (keeps row/column labels)
write.csv(X_colprop, "C:/Users/naamo/OneDrive/Documents/DnivRevisions/X_colprop.csv", quote = FALSE)

#make new similarity matrix using the newly normalized data to compare
newsimilarity_matrix <- cor(t(X_colprop), method = "pearson")

write.csv(similarity_matrix, "C:/Users/naamo/OneDrive/Documents/DnivRevisions/newsimilarity_matrix.csv", quote= FALSE)

``` 

```{r}
#heatmap using pearson correlation USE THIS


# Step 1: Read the transposed CAZyme data
cazyme_data_matrix <- read.csv("C:/Users/naamo/OneDrive/Documents/DnivRevisions/transposed_data_matrix.csv", row.names = 1, check.names = FALSE)


# Step 2: Compute the Pearson correlation matrix for organisms
similarity_matrix <- cor(t(cazyme_data_matrix), method = "pearson")

# Step 3: Extract similarity scores for Dendrothele nivosa
nivosa_similarity <- similarity_matrix["Dendrothele nivosa", ]
nivosa_similarity_sorted <- sort(nivosa_similarity, decreasing = TRUE)

# Print similarity scores
print("Similarity scores for Dendrothele nivosa:")
print(nivosa_similarity_sorted)

# Step 4: Generate heatmap of all organisms based on similarity
pearsonheatmap <- pheatmap(similarity_matrix,
         main = "CAZyme Similarity Heatmap (Pearson Correlation)",
         color = colorRampPalette(c("black", "blue", "red"))(100),
         fontsize_row = 8,
         fontsize_col = 8,
         clustering_distance_rows = "euclidean",
         clustering_distance_cols = "euclidean",
         clustering_method = "complete",
         treeheight_row = 50,  
         treeheight_col = 50)

dev.off()
pearsonheatmap

```













































































