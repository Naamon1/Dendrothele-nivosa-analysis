#Make sure 'Organism' is the row name
rownames(cazyme_data_matrix) <- cazyme_data_matrix$Organism
cazyme_data_matrix <- cazyme_data_matrix[ , -1]  # remove the Organism column

# 2. Normalize to relative abundance (row-wise)
cazyme_rel_abund <- cazyme_data_matrix / rowSums(cazyme_data_matrix)

# 3. Compute Bray-Curtis distance matrix
cazy_bray_dist <- vegdist(cazyme_rel_abund, method = "bray")

# 4. Join metadata
# Make sure rownames in metadata match the order of rows in cazyme_rel_abund
meta_cazyme_data <- meta_cazyme_data[match(rownames(cazyme_rel_abund), meta_cazyme_data$Organism), ]

# 5. Run PERMANOVA (e.g., testing for Group differences)
cazy_permanova_result <- adonis2(cazy_bray_dist ~ Group, data = meta_cazyme_data)

# 6. View results
print(cazy_permanova_result)

