Eggnog mapper was run in browser on a genome annotated with AUGUSTUS. All further analysis was done in R. This code mainly pertains to the manual creation of a spreadsheet containing all taxa and their gene counts for each CAZyme category. 

# How to make a table out of eggNOG outputs
```{r}
library(dplyr)
library(readr)
library(magrittr)
library(ggplot2)



#the below syntax is object , function. the arrow denotes an object. in quotes you put the file path then skip the extra stuff at the beginning of the file which is the first 4 lines

dniv<- read_tsv(file.choose(), skip=4)


```
```{r}
stereaceae <- read_tsv(file.choose(), skip=4)

stereaceae_sum <- group_by(stereaceae, PFAMs) %>% summarise(num_fam = n())



#filtering for combined table
filtered_stereaceae <- stereaceae_sum %>%
  filter(PFAMs %in% c ("Chromo,RVP_2,RVT_1,Retrotrans_gag,rve,zf-CCHC", "Chromo,Peptidase_A2E,RVT_1,rve", "rve", "gag-asp_proteas", "DUF5314,RVT_2,gag_pre-integrs,rve,zf-CCHC", "p450", "MFS_1", "RVT_2,Retrotran_gag_2,gag_pre-integrs,rve", "Pkinase", "RVT_2,Retrotran_gag_2,gag_pre-integrs,rve,zf-CCHC", "Asp_protease_2", "Retrotran_gag_2,gag_pre-integrs,rve", "WD40", "RVT_2,gag_pre-integrs,rve", "adh_short", "Sugar_tr", "RVP_2", "GMC_oxred_C,GMC_oxred_N", "RRM_1", "Chromo"))

stereaceae_sum <- stereaceae_sum[order(stereaceae_sum$num_fam, decreasing=TRUE),] %>% top_n(21) %>% slice(2:21)
# the code directly above this is not related to filtering for the combined table

stereaceae_caz <- group_by(stereaceae, CAZy) %>% summarise(num_fam = n())

stereaceae_caz <- stereaceae_caz[order(stereaceae_caz$num_fam, decreasing=TRUE),] %>% top_n(58) %>% slice(2:58)


#getting total count from the columns
sterallpfams <- stereaceae_sum %>% summarize(total= sum(num_fam, na.rm=TRUE))
print(sterallpfams)

sterallcazy <- stereaceae_caz %>% summarize(total=sum(num_caz, na.rm=TRUE))
print(sterallcazy)

#i am now in doubt about how useful ^^ is

```
